generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "mysql"
  url      = env("DATABASE_URL")
}

model User {
  id           String        @id @default(uuid())
  name         String
  email        String        @unique
  password     String
  transactions Transaction[]
  categories   Category[]    
}

model Category {
  id          String        @id @default(uuid())
  name        String        // Nome interno em inglês exigido pelo professor (ex: "health")
  displayName String        // Nome em português que aparece no app (ex: "Saúde")
  icon        String?       // Ícone exigido
  background  String?       // Cor de fundo exigida
  isIncome    Boolean       @default(false) // Substituiu o antigo "type"

  userId      String?       // Mantido para suas categorias personalizadas!
  user        User?         @relation(fields: [userId], references: [id])
  
  transactions Transaction[]
}

model Transaction {
  id          String   @id @default(uuid())
  description String   
  value       Float    // O professor exige "value" em vez de "amount"
  date        DateTime // O professor manda a data no teste, então tiramos o @default(now())
  
  userId      String
  user        User     @relation(fields: [userId], references: [id])
  
  categoryId  String
  category    Category @relation(fields: [categoryId], references: [id])
}